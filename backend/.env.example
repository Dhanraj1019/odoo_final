PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/peoplepay360_db
SESSION_SECRET=replace_with_a_long_random_session_secret_key_2026
SESSION_COOKIE_MAX_AGE=86400000

# Nodemailer / SMTP (leave blank for local mock or use test service like Ethereal/Mailtrap)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PeoplePay360 <no-reply@peoplepay360.local>"

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173
